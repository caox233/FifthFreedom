                               Margin="0,0,0,7"/>
                    <TextBlock x:Name="txtServerSettingsDescription"
                               Text="修改联机服务器。保存后启动器会自动重启。"
                               Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap"
                               LineHeight="19"
                               Margin="0,0,0,17"/>

                    <TextBlock x:Name="txtServerEndpointLabel"
                               Text="服务器地址（域名/IP:端口）"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtServerEndpoint"
                             Style="{StaticResource CinematicTextBox}"
                             Height="41"
                             Margin="0,0,0,13"/>

                    <TextBlock x:Name="txtServerUpdatePortLabel"
                               Text="更新服务端口"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtServerUpdatePort"
                             Style="{StaticResource CinematicTextBox}"
                             Height="41"
                             Margin="0,0,0,13"
                             PreviewTextInput="ServerPort_PreviewTextInput"
                             DataObject.Pasting="ServerPort_Pasting"/>

                    <TextBlock x:Name="txtTestServerEndpointLabel"
                               Text="测试服务器地址（域名/IP:端口）"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtTestServerEndpoint"
                             Style="{StaticResource CinematicTextBox}"
                             Height="41"
                             Margin="0,0,0,13"/>

                    <TextBlock x:Name="txtTestServerUpdatePortLabel"
                               Text="测试服务器更新端口"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtTestServerUpdatePort"
                             Style="{StaticResource CinematicTextBox}"
                             Height="41"
                             PreviewTextInput="ServerPort_PreviewTextInput"
                             DataObject.Pasting="ServerPort_Pasting"/>

                    <TextBlock x:Name="txtServerSettingsMessage"
                               MinHeight="20"
                               Foreground="#F6A7AF"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="2,10,0,0"/>

                    <Grid Margin="0,15,0,0">
                        <Button x:Name="btnServerSettingsReset"
                                HorizontalAlignment="Left"
                                MinWidth="86"
                                Content="恢复默认"
                                Style="{StaticResource DialogSecondaryButton}"
                                Click="ServerSettingsResetButton_Click"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="btnServerSettingsCancel"
                                    MinWidth="72"
                                    Content="取消"
                                    Style="{StaticResource DialogSecondaryButton}"
                                    Click="ServerSettingsCancelButton_Click"
                                    Margin="0,0,10,0"/>
                            <Button x:Name="btnServerSettingsSave"
                                    MinWidth="72"
                                    Content="保存"
                                    Style="{StaticResource DialogPrimaryButton}"
                                    Click="ServerSettingsSaveButton_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Canvas x:Name="guideOverlay"
                Grid.RowSpan="3"
                Panel.ZIndex="90"
                Visibility="Collapsed"
                Background="#70000000">
            <Border x:Name="guideHighlight"
                    BorderBrush="#E8FFFFFF"
                    BorderThickness="1"
                    CornerRadius="0"
                    Background="#0CFFFFFF"
                    IsHitTestVisible="False"/>

            <TextBlock x:Name="guideArrow"
                       Text="▲"
                       Foreground="#FFFFFF"
                       FontSize="18"
                       FontWeight="Bold"
                       Panel.ZIndex="91"
                       IsHitTestVisible="False"/>

            <Border x:Name="guideCard"
                     Width="360"
                     Background="#D0090A0B"
                     BorderBrush="#68FFFFFF"
                    BorderThickness="1"
                     CornerRadius="0"
                     Padding="22">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="30"
                                      ShadowDepth="8"
                                      Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="txtGuideStep"
                               Text="1 / 6"
                               Foreground="#8F9293"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtGuideTitle"
                               Text="指引标题"
                               Foreground="{StaticResource TextMainBrush}"
                               FontSize="18"
                               FontWeight="Normal"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtGuideMessage"
                               Text="指引内容"
                               Foreground="{StaticResource TextSubBrush}"
                               FontSize="12.3"
                               LineHeight="19"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnGuideSkip"
                                Content="跳过"
                                Width="62"
                                Style="{StaticResource DialogSecondaryButton}"
                                Click="GuideSkipButton_Click"
                                Margin="0,0,8,0"/>
                        <Button x:Name="btnGuidePrev"
                                Content="上一步"
                                Width="72"
                                Style="{StaticResource DialogSecondaryButton}"
                                Click="GuidePrevButton_Click"
                                Margin="0,0,8,0"/>
                        <Button x:Name="btnGuideNext"
                                Content="下一步"
                                Width="76"
                                Style="{StaticResource DialogPrimaryButton}"
                                Click="GuideNextButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>

    </Grid>
    </Viewbox>
</Window>
