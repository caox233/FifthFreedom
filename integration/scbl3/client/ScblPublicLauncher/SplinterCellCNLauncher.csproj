<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <RootNamespace>SplinterCellCNLauncher</RootNamespace>
    <AssemblyName>SCBL</AssemblyName>
    <Product>SCBL</Product>
    <AssemblyTitle>SCBL</AssemblyTitle>
    <Description>SCBL CONNECT</Description>
    <Company>SCBL</Company>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SmokeNoElevation)' == 'true'">
    <ApplicationManifest>app.smoke.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);SCBL_SMOKE_NO_ELEVATION</DefineConstants>
    <AssemblyName>SCBL.Smoke</AssemblyName>
  </PropertyGroup>

  <!-- Unit tests exercise managed launcher services on the host architecture.
       Production builds remain the x86 self-contained executable required by the game. -->
  <PropertyGroup Condition="'$(SCBLTestBuild)' == 'true'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifier></RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Validation can populate project-local obj before a frozen formal build
         redirects MSBuild to an external cache. Never compile those generated
         sources as ordinary project input. -->
    <Compile Remove="obj\**\*.cs" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.81.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\shared\api\proto\users.proto"
              Link="Contracts\users.proto"
              GrpcServices="Client" />
    <EmbeddedResource Include="Contracts\client_component_catalog.json"
                      Link="Contracts\client_component_catalog.json"
                      LogicalName="SCBL.ClientComponentCatalog.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="logo.ico" />
    <Resource Include="Assets\scbl-launcher-background-final.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ClientDataLayout.cs" Link="Shared\ClientDataLayout.cs" />
  </ItemGroup>

  <!-- Save templates remain embedded because they are tiny and versioned with Launcher behavior.
       Hooks is deliberately excluded: the full package carries it under components/hooks/ and
       runtime updates resolve newer versions through the selected server's component endpoint. -->
  <ItemGroup>
    <None Remove="EmbeddedFiles\**\*" />
    <EmbeddedResource Include="EmbeddedFiles\**\*" Exclude="EmbeddedFiles\uplay_r1_loader.dll" />
  </ItemGroup>

  <Import Project="..\SCBL.Version.props" />
</Project>
