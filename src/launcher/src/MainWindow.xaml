<Style xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:services="clr-namespace:SplinterCellCNLauncher.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="PrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="60" />
            <Setter Property="Width" Value="230" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="TextOptions.TextHintingMode" Value="Auto" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="buttonRoot" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="False" SnapsToDevicePixels="True" />
                            <TextBlock x:Name="launchArrow" Grid.Column="1" Text="→" FontSize="29" FontWeight="Normal" Margin="18,0,0,1" VerticalAlignment="Center" />
                            <Border x:Name="underline" Grid.ColumnSpan="2" Height="1" Background="#8BA5AEB2" VerticalAlignment="Bottom" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="underline" Property="Height" Value="2" />
                                <Setter TargetName="underline" Property="Background" Value="{StaticResource ReadyAccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="underline" Property="Height" Value="2" />
                                <Setter TargetName="underline" Property="Background" Value="{StaticResource ReadyAccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonRoot" Property="Opacity" Value="0.68" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonRoot" Property="Opacity" Value="0.35" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Progress">
                                <Setter TargetName="launchArrow" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Restart">
                                <Setter TargetName="launchArrow" Property="Text" Value="↻" />
                            </Trigger>
                            <Trigger Property="Tag" Value="EndGame">
                                <Setter TargetName="launchArrow" Property="Text" Value="×" />
                                <Setter TargetName="underline" Property="Background" Value="#786F7478" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        
<Style xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:services="clr-namespace:SplinterCellCNLauncher.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
