<Style xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:services="clr-namespace:SplinterCellCNLauncher.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
