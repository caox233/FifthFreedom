<Grid x:Name="toolsOverlay" Grid.RowSpan="3" Panel.ZIndex="95" Visibility="Collapsed" Background="#CC000000" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="ToolsOverlay_PreviewKeyDown">
