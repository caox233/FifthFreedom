<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:services="clr-namespace:SplinterCellCNLauncher.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="guideOverlay" Grid.RowSpan="3" Panel.ZIndex="90" Visibility="Collapsed" Background="#66000000">
            <Border x:Name="guideHighlight" BorderBrush="#7DFFAE" BorderThickness="1" CornerRadius="0" Background="#18FFFFFF" IsHitTestVisible="False" />

            <TextBlock x:Name="guideArrow" Text="▲" Foreground="#7DFFAE" FontSize="18" FontWeight="Bold" Panel.ZIndex="91" IsHitTestVisible="False" />

