+#[cfg(test)]
+mod fifth_freedom_receive_revision_contract {
+    use super::*;
+    #[test]
+    fn same_generation_sync_advances_revision_and_overflow_never_wraps() {
+        let session = PeerSession::new(10, [1;32], 1, 0,
+            "aes-256-gcm".into(), "aes-256-gcm".into(), Some([2;32]));
+        assert_eq!(session.receive_observation_revision(), Some(0));
+        session.sync_root_key([3;32],1,0,false);
+        assert_eq!(session.receive_observation_revision(), Some(2));
+        session.observation_revision.store(u64::MAX-1, Ordering::SeqCst);
+        session.sync_root_key([4;32],1,0,false);
+        assert!(session.is_valid());
+        assert!(session.receive_observation_revision().is_none());
+        session.sync_root_key([5;32],2,0,false);
+        assert!(session.receive_observation_revision().is_none());
+    }
