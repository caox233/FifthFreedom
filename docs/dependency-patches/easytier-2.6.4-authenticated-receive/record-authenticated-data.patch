+// Local observations only: deliberately no serde/protobuf constructor.
+// A snapshot does not keep a connection/session alive and must be revalidated
+// when used. Caller policy still owns peer authorization and maximum age.
+#[derive(Clone, Copy)]
+struct AuthenticatedDataReceived {
+    at: std::time::Instant,
+    generation: u32,
+    revision: u64,
+}
+struct SessionFilterState {
+    session: Option<Arc<PeerSession>>,
+    installation: Option<u64>,
+    received: Option<AuthenticatedDataReceived>,
+}
+impl Default for SessionFilterState {
+    fn default() -> Self {
+        Self { session: None, installation: Some(0), received: None }
+    }
+}
+
+pub struct AuthenticatedDataObservation {
+    filter: Weak<std::sync::Mutex<SessionFilterState>>,
+    session: Weak<PeerSession>,
+    close: Weak<PeerConnCloseNotify>,
+    conn_id: PeerConnId,
+    installation: u64,
+    received: AuthenticatedDataReceived,
+}
+impl AuthenticatedDataObservation {
+    pub fn connection_id(&self) -> PeerConnId { self.conn_id }
+
+    /// Age of accepted authenticated Data, never a remote-clock timestamp.
+    /// None after owner/session/connection loss or rehandshake. A successful
+    /// read is a local observation, not future liveness or active peer proof.
+    pub fn received_ago(&self) -> Option<std::time::Duration> {
+        let close = self.close.upgrade()?;
+        if close.is_closed() || close.get_conn_id() != self.conn_id { return None; }
+        let filter = self.filter.upgrade()?;
+        let state = filter.lock().ok()?;
+        let session = self.session.upgrade()?;
+        if state.installation != Some(self.installation)
+            || !state.session.as_ref().is_some_and(|current| Arc::ptr_eq(current, &session))
+            || !session.is_valid() || session.session_generation() != self.received.generation
+            || session.receive_observation_revision() != Some(self.received.revision)
+            || close.is_closed()
+        { return None; }
+        Some(self.received.at.elapsed())
+    }
+}
