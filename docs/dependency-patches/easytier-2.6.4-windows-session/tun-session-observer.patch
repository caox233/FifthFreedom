+//! Read-only identity from the adapter retained by an actual Wintun Session.
+//! This is not an encrypted-peer proof or an exclusive-adapter guarantee.
+use std::{io, net::Ipv4Addr};
+use windows_sys::{core::GUID, Win32::{Foundation::ERROR_SUCCESS,
+    NetworkManagement::{IpHelper::*, Ndis::{NET_LUID_LH, IfOperStatusUp}},
+    Networking::WinSock::{AF_INET, IpDadStatePreferred}}};
+use crate::session_lifetime::{unavailable, SessionObservation};
+pub use crate::session_lifetime::SessionIdentity;
+
+#[derive(Clone)]
+pub struct SessionIdentityObserver(pub(crate) SessionObservation<wintun::Session>);
+impl SessionIdentityObserver {
+    /// Observe the retained session's adapter identity. No name-based adoption.
+    pub fn identity(&self) -> io::Result<SessionIdentity> {
+        self.0.observe(|session| read_adapter(&session.get_adapter()))
+    }
+    /// Verify configured IPv4/interface state after configuration has completed.
+    /// Any observed loss is terminal for this observer, including rename-back.
+    pub fn observe_ipv4(&self, source: Ipv4Addr) -> io::Result<SessionIdentity> {
+        self.0.observe(|session| {
+            let identity = read_adapter(&session.get_adapter())?;
+            unsafe {
+                let mut interface: MIB_IF_ROW2 = std::mem::zeroed();
+                interface.InterfaceLuid.Value = identity.luid;
+                if GetIfEntry2(&mut interface) != ERROR_SUCCESS || interface.OperStatus != IfOperStatusUp
+                    || interface.InterfaceIndex != identity.index { return Err(unavailable()); }
+                let mut address: MIB_UNICASTIPADDRESS_ROW = std::mem::zeroed();
+                address.InterfaceLuid.Value = identity.luid;
+                address.Address.Ipv4.sin_family = AF_INET;
+                address.Address.Ipv4.sin_addr.S_un.S_addr = u32::from_ne_bytes(source.octets());
+                if GetUnicastIpAddressEntry(&mut address) != ERROR_SUCCESS
+                    || address.InterfaceLuid.Value != identity.luid || address.InterfaceIndex != identity.index
+                    || address.Address.Ipv4.sin_family != AF_INET
+                    || address.Address.Ipv4.sin_addr.S_un.S_addr != u32::from_ne_bytes(source.octets())
+                    || address.DadState != IpDadStatePreferred || address.ValidLifetime == 0 {
+                    return Err(unavailable());
+                }
+            }
+            Ok(identity)
+        })
+    }
+    pub(crate) fn revoke(&self) { self.0.revoke(); }
+}
+
+pub(crate) fn read_adapter(adapter: &wintun::Adapter) -> io::Result<SessionIdentity> {
+    unsafe {
+        // get_guid() in wintun 0.5.0 caches the requested GUID. Query the actual
+        // retained handle's LUID, then independently obtain GUID/index/alias.
+        let luid = NET_LUID_LH { Value: adapter.get_luid().Value };
+        let mut guid: GUID = std::mem::zeroed();
+        let mut index = 0;
+        let mut alias = [0u16; 257];
+        if luid.Value == 0 || ConvertInterfaceLuidToGuid(&luid, &mut guid) != ERROR_SUCCESS
+            || ConvertInterfaceLuidToIndex(&luid, &mut index) != ERROR_SUCCESS
+            || ConvertInterfaceLuidToAlias(&luid, alias.as_mut_ptr(), alias.len()) != ERROR_SUCCESS || index == 0 {
+            return Err(unavailable());
+        }
+        let end = alias.iter().position(|value| *value == 0).ok_or_else(unavailable)?;
+        let name = String::from_utf16(&alias[..end]).map_err(|_| unavailable())?;
+        let guid = (u128::from(guid.data1) << 96) | (u128::from(guid.data2) << 80)
+            | (u128::from(guid.data3) << 64) | u128::from(u64::from_be_bytes(guid.data4));
+        Ok(SessionIdentity { name, guid, luid: luid.Value, index })
+    }
+}
