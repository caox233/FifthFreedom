+//! Local lifetime/identity observations, not encrypted-peer or process authority.
+use std::io;
+use std::sync::{Arc, Weak, atomic::{AtomicBool, Ordering}};
+
+pub(crate) fn unavailable() -> io::Error {
+    io::Error::new(io::ErrorKind::NotConnected, "OWNED_TUN_SESSION_UNAVAILABLE")
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct SessionIdentity {
+    pub name: String,
+    pub guid: u128,
+    pub luid: u64,
+    pub index: u32,
+}
+
+pub(crate) fn validate_name(name: &str, guid: u128) -> io::Result<()> {
+    if guid == 0 || name != format!("ff-{guid:032x}") { return Err(unavailable()); }
+    Ok(())
+}
+
+pub(crate) struct SessionOwner(Arc<AtomicBool>);
+impl SessionOwner {
+    pub(crate) fn revoke(&self) { self.0.store(false, Ordering::Release); }
+}
+impl Drop for SessionOwner { fn drop(&mut self) { self.revoke(); } }
+
+pub(crate) struct SessionObservation<T> {
+    session: Weak<T>,
+    alive: Arc<AtomicBool>,
+    identity: SessionIdentity,
+}
+impl<T> Clone for SessionObservation<T> {
+    fn clone(&self) -> Self {
+        Self { session: self.session.clone(), alive: self.alive.clone(), identity: self.identity.clone() }
+    }
+}
+impl<T> SessionObservation<T> {
+    pub(crate) fn new(session: &Arc<T>, identity: SessionIdentity) -> io::Result<(SessionOwner, Self)> {
+        validate_name(&identity.name, identity.guid)?;
+        if identity.luid == 0 || identity.index == 0 { return Err(unavailable()); }
+        let alive = Arc::new(AtomicBool::new(true));
+        Ok((SessionOwner(alive.clone()), Self { session: Arc::downgrade(session), alive, identity }))
+    }
+    pub(crate) fn revoke(&self) { self.alive.store(false, Ordering::Release); }
+    pub(crate) fn observe(&self, read: impl FnOnce(&T) -> io::Result<SessionIdentity>) -> io::Result<SessionIdentity> {
+        if !self.alive.load(Ordering::Acquire) { return Err(unavailable()); }
+        let result = self.session.upgrade().ok_or_else(unavailable).and_then(|session| read(&session));
+        match result {
+            Ok(identity) if identity == self.identity && self.alive.load(Ordering::Acquire) => Ok(identity),
+            _ => { self.revoke(); Err(unavailable()) }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn identity() -> SessionIdentity {
+        SessionIdentity { name: format!("ff-{:032x}", 7), guid: 7, luid: 12, index: 3 }
+    }
+    #[test]
+    fn creation_names_are_explicit_nonzero_and_exact() {
+        assert!(validate_name(&identity().name, 7).is_ok());
+        for (name, guid) in [("wintun".into(), 7), ("ff-00000000000000000000000000000000".into(), 0),
+            ("FF-00000000000000000000000000000007".into(), 7), (identity().name, 8)] {
+            assert!(validate_name(&name, guid).is_err());
+        }
+    }
+    #[test]
+    fn owner_drop_revokes_even_when_other_session_references_survive() {
+        let session = Arc::new(());
+        let (owner, observer) = SessionObservation::new(&session, identity()).unwrap();
+        assert!(observer.observe(|_| Ok(identity())).is_ok());
+        drop(owner);
+        assert!(observer.observe(|_| panic!("must not call kernel reader after owner loss")).is_err());
+        assert_eq!(Arc::strong_count(&session), 1);
+    }
+    #[test]
+    fn observer_never_extends_session_lifetime() {
+        let session = Arc::new(());
+        let (_owner, observer) = SessionObservation::new(&session, identity()).unwrap();
+        let another = observer.clone();
+        assert_eq!(Arc::strong_count(&session), 1);
+        drop(session);
+        assert!(another.observe(|_| panic!("closed session")).is_err());
+    }
+    #[test]
+    fn every_kernel_identity_component_is_pinned_and_loss_is_sticky() {
+        for field in 0..4 {
+            let session = Arc::new(());
+            let (_owner, observer) = SessionObservation::new(&session, identity()).unwrap();
+            let mut changed = identity();
+            match field { 0 => changed.guid += 1, 1 => changed.luid += 1,
+                2 => changed.index += 1, _ => changed.name.push('x') }
+            assert!(observer.observe(|_| Ok(changed)).is_err());
+            assert!(observer.observe(|_| Ok(identity())).is_err());
+        }
+    }
+    #[test]
+    fn kernel_failure_and_worker_failure_revoke_all_observers() {
+        let session = Arc::new(());
+        let (_owner, observer) = SessionObservation::new(&session, identity()).unwrap();
+        let copy = observer.clone();
+        assert!(observer.observe(|_| Err(io::Error::other("injected private details"))).is_err());
+        assert_eq!(copy.observe(|_| Ok(identity())).unwrap_err().to_string(), "OWNED_TUN_SESSION_UNAVAILABLE");
+        let (_owner, other) = SessionObservation::new(&session, identity()).unwrap();
+        other.revoke();
+        assert!(other.observe(|_| Ok(identity())).is_err());
+    }
+    #[test]
+    fn a_late_successful_read_cannot_restore_a_revoked_owner() {
+        let session = Arc::new(());
+        let (owner, observer) = SessionObservation::new(&session, identity()).unwrap();
+        assert!(observer.observe(|_| { owner.revoke(); Ok(identity()) }).is_err());
+    }
+}
