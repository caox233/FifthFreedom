+    #[tokio::test]
+    async fn fifth_freedom_data_challenge_noise_echo_and_policy() {
+        let (c,s)=create_ring_tunnel_pair();
+        let cid=new_peer_id(); let sid=new_peer_id();
+        let cc=get_mock_global_ctx(); let sc=get_mock_global_ctx();
+        set_secure_mode_cfg(&cc,true); set_secure_mode_cfg(&sc,true);
+        // Pin independently to the owned synthetic server's configured key,
+        // not a key first learned from the received handshake metadata.
+        let key:[u8;32]=BASE64_STANDARD.decode(sc.config.get_secure_mode().unwrap().local_public_key.unwrap()).unwrap().try_into().unwrap();
+        let ps=Arc::new(PeerSessionStore::new());
+        let mut client=PeerConn::new(cid,cc,Box::new(c),ps.clone());
+        let mut server=PeerConn::new(sid,sc,Box::new(s),ps);
+        let (cr,sr)=tokio::join!(client.do_handshake_as_client(),server.do_handshake_as_server()); cr.unwrap(); sr.unwrap();
+        assert_eq!(client.get_conn_info().noise_remote_static_pubkey,key);
+        let endpoints=DataChallengeEndpoints { local_ipv4:"10.66.0.10".parse().unwrap(), remote_ipv4:"10.66.0.20".parse().unwrap(), local_port:23001,remote_port:23002 };
+        let mut wrong=key; wrong[0]^=1;
+        assert!(matches!(client.send_data_challenge(sid,wrong,endpoints,Duration::from_secs(2)).await,Err(DataChallengeError::Unavailable)));
+        assert!(matches!(client.send_data_challenge(sid.wrapping_add(1),key,endpoints,Duration::from_secs(2)).await,Err(DataChallengeError::Unavailable)));
+        let (ss,mut sr)=create_packet_recv_chan(); server.start_recv_loop(ss).await;
+        let (cs,mut cr)=create_packet_recv_chan(); client.start_recv_loop(cs).await;
+        let mut ticket=client.send_data_challenge(sid,key,endpoints,Duration::from_secs(2)).await.unwrap();
+        let request=timeout(Duration::from_secs(1),recv_packet_from_chan(&mut sr)).await.unwrap().unwrap();
+        let mut bytes=request.payload().to_vec();
+        // Model only the remote kernel/echo response, without creating a socket
+        // or claiming that an actual TUN/UDP service was reached.
+        {
+            let mut ip=pnet::packet::ipv4::MutableIpv4Packet::new(&mut bytes).unwrap();
+            let src=ip.get_source(); let dst=ip.get_destination();
+            ip.set_source(dst); ip.set_destination(src);
+            ip.set_checksum(pnet::packet::ipv4::checksum(&ip.to_immutable()));
+        }
+        {
+            let mut udp=pnet::packet::udp::MutableUdpPacket::new(&mut bytes[20..]).unwrap();
+            let src=udp.get_source(); let dst=udp.get_destination(); udp.set_source(dst); udp.set_destination(src);
+            let checksum=pnet::packet::udp::ipv4_checksum(&udp.to_immutable(),&endpoints.remote_ipv4,&endpoints.local_ipv4);
+            udp.set_checksum(if checksum==0 {0xffff} else {checksum});
+        }
+        let mut response=ZCPacket::new_with_payload(&bytes); response.fill_peer_manager_hdr(sid,cid,PacketType::Data as u8);
+        server.send_msg(response).await.unwrap();
+        let accepted=timeout(Duration::from_secs(1),recv_packet_from_chan(&mut cr)).await.unwrap().unwrap();
+        assert_eq!(accepted.payload(),bytes); let proof=ticket.take_response().unwrap();
+        assert_eq!(proof.connection_id(),client.get_conn_id()); assert!(proof.round_trip_if_current().is_some());
+        assert!(ticket.take_response().is_none()); drop(client); assert!(proof.round_trip_if_current().is_none());
     }
 
