+
+    #[tokio::test]
+    async fn observed_removal_is_sticky_after_same_arc_reinsertion() {
+        let mut f = Fixture::new(false).await;
+        let mut ticket = f.start(Duration::from_secs(2)).await.unwrap();
+        let response = f.completed(&mut ticket).await;
+        f.map.peer_map.remove(&f.remote_id);
+        assert!(response.round_trip_if_current().is_none());
+        f.map.peer_map.insert(f.remote_id, f.peer.clone());
+        assert!(response.round_trip_if_current().is_none());
+    }
+
+    #[tokio::test]
+    async fn actual_map_owner_drop_invalidates_a_retained_response() {
+        let mut f = Fixture::new(false).await;
+        let mut ticket = f.start(Duration::from_secs(2)).await.unwrap();
+        let response = f.completed(&mut ticket).await;
+        let retained = f.connection.clone();
+        let weak = Arc::downgrade(&f.map);
+        drop(f);
+        assert!(weak.upgrade().is_none());
+        assert!(response.round_trip_if_current().is_none());
+        drop(retained);
+    }
+
+    #[tokio::test]
+    async fn late_send_completion_rechecks_peer_membership() {
+        let f = Fixture::new(false).await;
+        let mut ticket = f.start(Duration::from_secs(2)).await.unwrap();
+        let inner = ticket.inner.take().unwrap();
+        let membership = ticket.membership.clone();
+        let (release, waiter) = tokio::sync::oneshot::channel();
+        let future = finish_send(membership, async { waiter.await.unwrap(); Ok(inner) });
+        tokio::pin!(future);
+        assert!(futures::poll!(&mut future).is_pending());
+        f.map.peer_map.remove(&f.remote_id);
+        release.send(()).unwrap();
+        assert!(matches!(future.await, Err(DataChallengeError::Unavailable)));
+        // Post-await failure dropped the actual nonce ticket; no stuck slot.
+        assert!(f.connection.send_data_challenge(f.remote_id,f.key,f.endpoints,Duration::from_secs(2)).await.is_ok());
+    }
+
+    #[tokio::test]
+    async fn cancel_and_timeout_drop_the_real_inflight_nonce_ticket() {
+        let f = Fixture::new(false).await;
+        for cancel in [true, false] {
+            let mut ticket = f.start(Duration::from_millis(50)).await.unwrap();
+            let inner = ticket.inner.take().unwrap();
+            let future = finish_send(ticket.membership.clone(), async {
+                let _owned = inner;
+                std::future::pending::<Result<DataChallenge,DataChallengeError>>().await
+            });
+            let mut future = Box::pin(future);
+            assert!(futures::poll!(&mut future).is_pending());
+            if cancel { drop(future); }
+            else { assert!(matches!(future.await,Err(DataChallengeError::TimedOut))); }
+            let fresh = f.connection.send_data_challenge(f.remote_id,f.key,f.endpoints,Duration::from_secs(2)).await.unwrap();
+            drop(fresh);
+        }
+    }
+
+    #[tokio::test]
+    async fn delaying_first_poll_does_not_reset_original_budget() {
+        let f = Fixture::new(false).await;
+        let future = f.start(Duration::from_millis(20));
+        tokio::time::sleep(Duration::from_millis(30)).await;
+        assert!(future.await.is_err());
+        assert!(f.start(Duration::from_secs(2)).await.is_ok());
+    }
+
+    #[tokio::test]
+    async fn dropping_expired_wrapper_cannot_clear_the_new_nonce() {
+        let mut f = Fixture::new(false).await;
+        let old = f.start(Duration::from_millis(20)).await.unwrap();
+        // Drain that request without replying; it must not complete a later nonce.
+        recv_packet_from_chan(&mut f.server_rx).await.unwrap();
+        tokio::time::sleep(Duration::from_millis(30)).await;
+        let mut fresh = f.start(Duration::from_secs(2)).await.unwrap();
+        drop(old);
+        assert!(f.completed(&mut fresh).await.round_trip_if_current().is_some());
+    }
