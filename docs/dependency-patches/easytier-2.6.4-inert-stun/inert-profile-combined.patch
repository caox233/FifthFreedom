+mod fifth_freedom_stun_inert_rpc_contracts {
+    use super::*;
+    #[test]
+    fn explicit_nonzero_loopback_keeps_its_exact_address() {
+        assert_eq!(parse_rpc_portal(Some("127.0.0.1:15998".into())).unwrap(), "127.0.0.1:15998".parse::<SocketAddr>().unwrap());
+    }
+    #[test]
+    fn bare_numeric_port_is_not_a_loopback_configuration() {
+        // This branch returns directly, so neither case opens a probe socket.
+        assert!(parse_rpc_portal(Some("15998".into())).unwrap().ip().is_unspecified());
+        assert!(parse_rpc_portal(Some("example.invalid:15998".into())).is_err());
+    }
