+#[cfg(test)]
+mod fifth_freedom_stun_collector_contracts {
+    use super::*;
+    #[tokio::test(flavor = "current_thread")]
+    async fn empty_get_stun_info_creates_no_tasks_or_started_state() {
+        let collector = StunInfoCollector::new(vec![], vec![], vec![]);
+        let info = collector.get_stun_info();
+        // Deliberately no await after this call: before-fix spawned tasks cannot
+        // run sockets or DNS before the failed assertion drops the collector.
+        assert!(info.public_ip.is_empty());
+        assert_eq!(collector.tasks.lock().unwrap().len(), 0);
+        assert!(!collector.started.load(std::sync::atomic::Ordering::Relaxed));
+    }
+    #[test]
+    fn unchanged_default_constructor_keeps_exact_default_lists() {
+        let collector = StunInfoCollector::new_with_default_servers();
+        assert_eq!(*collector.stun_servers.read().unwrap(), StunInfoCollector::get_default_servers());
+        assert_eq!(*collector.tcp_stun_servers.read().unwrap(), StunInfoCollector::get_default_tcp_servers());
+        assert_eq!(*collector.stun_servers_v6.read().unwrap(), StunInfoCollector::get_default_servers_v6());
+        assert!(!collector.started.load(std::sync::atomic::Ordering::Relaxed));
+    }
+    #[test]
+    fn actual_config_factory_applies_all_three_custom_lists() {
+        use crate::common::config::TomlConfigLoader;
+        let config = TomlConfigLoader::new_from_str(r#"
+stun_servers=["198.51.100.21:3478"]
+tcp_stun_servers=["198.51.100.22:3478"]
+stun_servers_v6=["[2001:db8::21]:3478"]
+"#).unwrap();
+        let collector = StunInfoCollector::from_config(&config);
+        assert_eq!(*collector.stun_servers.read().unwrap(), vec!["198.51.100.21:3478"]);
+        assert_eq!(*collector.tcp_stun_servers.read().unwrap(), vec!["198.51.100.22:3478"]);
+        assert_eq!(*collector.stun_servers_v6.read().unwrap(), vec!["[2001:db8::21]:3478"]);
+        assert_eq!(collector.tasks.lock().unwrap().len(), 0);
+        assert!(!collector.started.load(std::sync::atomic::Ordering::Relaxed));
+    }
+    #[test]
+    fn omission_factory_retains_all_existing_default_functions() {
+        use crate::common::config::{ConfigLoader, TomlConfigLoader};
+        let config = TomlConfigLoader::default();
+        assert_eq!(config.get_tcp_stun_servers(), None);
+        let collector = StunInfoCollector::from_config(&config);
+        assert_eq!(*collector.stun_servers.read().unwrap(), StunInfoCollector::get_default_servers());
+        assert_eq!(*collector.tcp_stun_servers.read().unwrap(), StunInfoCollector::get_default_tcp_servers());
+        assert_eq!(*collector.stun_servers_v6.read().unwrap(), StunInfoCollector::get_default_servers_v6());
+        // Upstream cfg(test) returns empty defaults. These constants and the
+        // production fallback functions are retained, not contacted by tests.
+        assert!(!DEFAULT_UDP_STUN_SERVERS.is_empty());
+        assert!(!DEFAULT_TCP_STUN_SERVERS.is_empty());
+        assert!(!DEFAULT_UDP_V6_STUN_SERVERS.is_empty());
+    }
+    #[tokio::test(flavor = "current_thread")]
+    async fn real_inert_config_factory_does_not_start_after_observation() {
+        use crate::common::config::TomlConfigLoader;
+        let config = TomlConfigLoader::new_from_str(include_str!("../../tests/fifth_freedom_inert_profile.toml")).unwrap();
+        let collector = StunInfoCollector::from_config(&config);
+        collector.get_stun_info();
+        assert_eq!(collector.tasks.lock().unwrap().len(), 0);
+        assert!(!collector.started.load(std::sync::atomic::Ordering::Relaxed));
+    }
+    #[tokio::test(flavor = "current_thread")]
+    async fn explicit_later_setter_can_enable_an_unstarted_collector() {
+        let collector = StunInfoCollector::new(vec![], vec![], vec![]);
+        collector.get_stun_info();
+        assert!(!collector.started.load(std::sync::atomic::Ordering::Relaxed));
+        collector.set_tcp_stun_servers(vec!["198.51.100.23:3478".into()]);
+        collector.get_stun_info();
+        // No await: verify only queued-state compatibility, then Drop aborts
+        // the futures before this current-thread runtime can poll any network.
+        assert!(collector.started.load(std::sync::atomic::Ordering::Relaxed));
+        assert_eq!(collector.tasks.lock().unwrap().len(), 3);
+    }
+
