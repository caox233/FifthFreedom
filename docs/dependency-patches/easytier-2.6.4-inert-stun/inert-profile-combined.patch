+instance_name = "fifth-freedom-owned-read-inert"
+ipv4 = "10.254.253.1/24"
+dhcp = false
+ipv6_public_addr_provider = false
+ipv6_public_addr_auto = false
+listeners = []
+peer = []
+mapped_listeners = []
+exit_nodes = []
+proxy_network = []
+routes = []
+port_forward = []
+stun_servers = []
+tcp_stun_servers = []
+stun_servers_v6 = []
+
+[network_identity]
+network_name = "fifth-freedom-owned-read-inert"
+network_secret = "synthetic-no-network-peers"
+
+[flags]
+enable_encryption = true
+enable_ipv6 = false
+no_tun = false
+use_smoltcp = false
+enable_exit_node = false
+proxy_forward_by_system = false
