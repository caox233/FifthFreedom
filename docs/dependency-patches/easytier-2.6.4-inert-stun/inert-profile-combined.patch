+#[cfg(test)]
+mod fifth_freedom_stun_config_contracts {
+    use super::*;
+    #[test]
+    fn explicit_tcp_list_survives_real_toml_roundtrip() {
+        let config = TomlConfigLoader::new_from_str(r#"tcp_stun_servers = ["198.51.100.10:3478"]"#).unwrap();
+        let value: toml::Value = toml::from_str(&config.dump()).unwrap();
+        assert_eq!(value.get("tcp_stun_servers"), Some(&toml::Value::Array(vec![toml::Value::String("198.51.100.10:3478".into())])));
+    }
+    #[test]
+    fn explicit_empty_lists_are_not_replaced_by_omission() {
+        let config = TomlConfigLoader::new_from_str("stun_servers=[]\ntcp_stun_servers=[]\nstun_servers_v6=[]\n").unwrap();
+        let value: toml::Value = toml::from_str(&config.dump()).unwrap();
+        for name in ["stun_servers", "tcp_stun_servers", "stun_servers_v6"] {
+            assert_eq!(value.get(name), Some(&toml::Value::Array(vec![])), "{name}");
+        }
+    }
+    #[test]
+    fn existing_custom_udp_and_ipv6_lists_keep_their_values() {
+        let config = TomlConfigLoader::new_from_str(r#"
+stun_servers = ["198.51.100.11:3478"]
+stun_servers_v6 = ["[2001:db8::11]:3478"]
+"#).unwrap();
+        let reparsed = TomlConfigLoader::new_from_str(&config.dump()).unwrap();
+        assert_eq!(reparsed.get_stun_servers(), Some(vec!["198.51.100.11:3478".into()]));
+        assert_eq!(reparsed.get_stun_servers_v6(), Some(vec!["[2001:db8::11]:3478".into()]));
+    }
+    #[test]
+    fn tcp_option_setters_preserve_omission_empty_and_custom() {
+        let config = TomlConfigLoader::default();
+        assert_eq!(config.get_tcp_stun_servers(), None);
+        config.set_tcp_stun_servers(Some(vec![]));
+        let empty = TomlConfigLoader::new_from_str(&config.dump()).unwrap();
+        assert_eq!(empty.get_tcp_stun_servers(), Some(vec![]));
+        config.set_tcp_stun_servers(Some(vec!["198.51.100.12:3478".into()]));
+        let custom = TomlConfigLoader::new_from_str(&config.dump()).unwrap();
+        assert_eq!(custom.get_tcp_stun_servers(), Some(vec!["198.51.100.12:3478".into()]));
+        config.set_tcp_stun_servers(None);
+        assert_eq!(TomlConfigLoader::new_from_str(&config.dump()).unwrap().get_tcp_stun_servers(), None);
+    }
+    #[test]
+    fn inert_owned_profile_uses_real_config_getters_and_survives_dump() {
+        let input = include_str!("../../tests/fifth_freedom_inert_profile.toml");
+        let original = TomlConfigLoader::new_from_str(input).unwrap();
+        let reparsed = TomlConfigLoader::new_from_str(&original.dump()).unwrap();
+        for config in [original, reparsed] {
+            assert_eq!(config.get_ipv4().unwrap().to_string(), "10.254.253.1/24");
+            assert!(!config.get_dhcp());
+            assert!(config.get_ipv6().is_none());
+            assert!(!config.get_ipv6_public_addr_auto());
+            assert!(!config.get_ipv6_public_addr_provider());
+            assert_eq!(config.get_listeners(), Some(vec![]));
+            assert!(config.get_peers().is_empty());
+            assert!(config.get_mapped_listeners().is_empty());
+            assert!(config.get_exit_nodes().is_empty());
+            assert!(config.get_proxy_cidrs().is_empty());
+            assert_eq!(config.get_routes(), Some(vec![]));
+            assert!(config.get_port_forwards().is_empty());
+            assert!(config.get_socks5_portal().is_none());
+            assert!(config.get_vpn_portal_config().is_none());
+            assert_eq!(config.get_stun_servers(), Some(vec![]));
+            assert_eq!(config.get_tcp_stun_servers(), Some(vec![]));
+            assert_eq!(config.get_stun_servers_v6(), Some(vec![]));
+            let flags = config.get_flags();
+            assert!(flags.enable_encryption);
+            assert!(!flags.enable_ipv6 && !flags.no_tun && !flags.use_smoltcp);
+            assert!(!flags.enable_exit_node && !flags.proxy_forward_by_system);
+            assert!(!flags.accept_dns && !flags.enable_udp_broadcast_relay);
+            assert!(flags.disable_upnp && flags.disable_p2p && !flags.need_p2p);
+            assert!(flags.disable_tcp_hole_punching && flags.disable_udp_hole_punching && flags.disable_sym_hole_punching);
+            assert!(!flags.enable_kcp_proxy && flags.disable_kcp_input && flags.disable_relay_kcp && !flags.enable_relay_foreign_network_kcp);
+            assert!(!flags.enable_quic_proxy && flags.disable_quic_input && flags.disable_relay_quic && !flags.enable_relay_foreign_network_quic);
+            assert!(flags.disable_relay_data && !flags.relay_all_peer_rpc);
+            assert!(flags.relay_network_whitelist.is_empty());
+        }
+    }
+
+}
